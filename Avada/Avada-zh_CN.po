msgstr "分页框高宽"

#: includes/options/extra.php:745
msgid "Controls the width and height of the displayed page links."
msgstr "控制显示的页面链接高宽。"

#: includes/options/extra.php:769
msgid "Pagination Box Padding"
msgstr "分页框间距"

#: includes/options/extra.php:770
